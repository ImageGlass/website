@{
  var adLinkRel = ViewData["adLinkRel"]?.ToString() ?? "nofollow";
}

@* Sponsor Ads *@
<div class="mb-4">
  <div class="mb-1" style="font-size: 0.75rem;">
    ✨ <span class="opacity-75">Sponsor</span>
  </div>

  <a class="sponsor-card card-style--0" href="https://www.aiarty.com/ai-image-enhancer/?ttref=2511-aia-vend-db-imgs-ly" target="_blank" rel="noopener noreferrer @adLinkRel" title="Aiarty Image Enhancer [AI-Powered]">
    <span class="card-image">
      <img src="~/img/sponsors/aiarty-image-enhancer-banner-202511.png" alt="Aiarty Image Enhancer [AI-Powered]">
    </span>
    <span class="card-text">
      <h4 class="card-heading">Aiarty Image Enhancer [AI-Powered]</h4>
      <span class="card-description">
        Denoise, deblur, and remove artifacts,
        upscale to 32K, restore old photo in clicks!
      </span>
    </span>
  </a>

</div>
